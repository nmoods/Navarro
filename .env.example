# NaRRAVO configuration. Copy to `.env` (repo root) and adjust. Every variable is optional for local
# development; the defaults run everything on this machine with SQLite and local file storage.
# NEVER commit `.env`. Values marked [secret] must never be exposed to the frontend.

# --- Runtime -------------------------------------------------------------------------------------------
NARRAVO_APP_ENV=development            # development | test | production
NARRAVO_PUBLIC_API_URL=http://127.0.0.1:8010
NARRAVO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NARRAVO_LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------------------------------
# Local default: SQLite in backend/var. Production: PostgreSQL (e.g. Supabase or Neon), psycopg 3 driver.
# NARRAVO_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres   [secret]

# --- Authentication ------------------------------------------------------------------------------------
NARRAVO_AUTH_MODE=local                # local (built-in accounts) | supabase (Supabase Auth JWTs via JWKS)
NARRAVO_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars   # [secret] required in production
NARRAVO_ACCESS_TOKEN_MINUTES=15
NARRAVO_REFRESH_TOKEN_DAYS=14
# NARRAVO_SUPABASE_URL=https://<project>.supabase.co

# --- Media storage -------------------------------------------------------------------------------------
NARRAVO_STORAGE_BACKEND=local          # local | r2
# NARRAVO_R2_ACCOUNT_ID=
# NARRAVO_R2_BUCKET=narravo-media
# NARRAVO_R2_ACCESS_KEY_ID=            # [secret]
# NARRAVO_R2_SECRET_ACCESS_KEY=        # [secret]

# --- AI providers (all local; see docs/user-guide/installation.md) ------------------------------------
NARRAVO_LLM_PROVIDER=ollama            # ollama | fixture (tests only)
NARRAVO_OLLAMA_URL=http://127.0.0.1:11434
NARRAVO_OLLAMA_MODEL=qwen3.5:4b        # qwen3.5:9b for higher quality, qwen3.5:2b for low RAM
NARRAVO_IMAGE_PROVIDER=auto            # auto (OpenVINO, then ComfyUI, then procedural art) | openvino | comfyui | procedural | fixture
# NARRAVO_OPENVINO_MODEL_DIR=.runtime/models/openvino/lcm-dreamshaper-v7-taesd   # default; created by setup-ai
NARRAVO_OPENVINO_DEVICE=CPU            # CPU, GPU (Intel graphics) or NPU
NARRAVO_OPENVINO_STEPS=4
NARRAVO_COMFYUI_URL=http://127.0.0.1:8188
NARRAVO_COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
NARRAVO_COMFYUI_LCM_LORA=lcm-lora-sdv1-5.safetensors
NARRAVO_COMFYUI_STEPS=6
NARRAVO_TTS_PROVIDER=kokoro            # kokoro | fixture
NARRAVO_STT_PROVIDER=faster_whisper    # faster_whisper | fixture
NARRAVO_WHISPER_MODEL=base.en          # small.en is more accurate, slower
NARRAVO_RESEARCH_ENABLED=true          # Wikipedia fact-checking (needs internet)
# NARRAVO_RESEARCH_CONTACT=https://github.com/you/your-fork   # email or URL; REQUIRED by Wikimedia's robot policy

# --- Worker & limits -----------------------------------------------------------------------------------
NARRAVO_EMBEDDED_WORKER=true           # run the job worker inside the API process (set false and run
                                         # `python -m app.workers.runner` separately in production)
NARRAVO_WORKER_CONCURRENCY=1
NARRAVO_MAX_ACTIVE_JOBS_PER_USER=3
NARRAVO_GENERATION_RATE_LIMIT_PER_HOUR=30
NARRAVO_RATE_LIMIT_PER_MINUTE=120
NARRAVO_MAX_UPLOAD_BYTES=26214400
NARRAVO_FFMPEG_THREADS=4

# --- Frontend (Vite; these ARE public, never put secrets here) -----------------------------------------
VITE_API_URL=http://127.0.0.1:8010
VITE_AUTH_MODE=local
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key>
