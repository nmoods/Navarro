# ReelForge AI configuration. Copy to `.env` (repo root) and adjust. Every variable is optional for local
# development; the defaults run everything on this machine with SQLite and local file storage.
# NEVER commit `.env`. Values marked [secret] must never be exposed to the frontend.

# --- Runtime -------------------------------------------------------------------------------------------
REELFORGE_APP_ENV=development            # development | test | production
REELFORGE_PUBLIC_API_URL=http://127.0.0.1:8000
REELFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REELFORGE_LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------------------------------
# Local default: SQLite in backend/var. Production: PostgreSQL (e.g. Supabase or Neon), psycopg 3 driver.
# REELFORGE_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres   [secret]

# --- Authentication ------------------------------------------------------------------------------------
REELFORGE_AUTH_MODE=local                # local (built-in accounts) | supabase (Supabase Auth JWTs via JWKS)
REELFORGE_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars   # [secret] required in production
REELFORGE_ACCESS_TOKEN_MINUTES=15
REELFORGE_REFRESH_TOKEN_DAYS=14
# REELFORGE_SUPABASE_URL=https://<project>.supabase.co

# --- Media storage -------------------------------------------------------------------------------------
REELFORGE_STORAGE_BACKEND=local          # local | r2
# REELFORGE_R2_ACCOUNT_ID=
# REELFORGE_R2_BUCKET=reelforge-media
# REELFORGE_R2_ACCESS_KEY_ID=            # [secret]
# REELFORGE_R2_SECRET_ACCESS_KEY=        # [secret]

# --- AI providers (all local; see docs/user-guide/installation.md) ------------------------------------
REELFORGE_LLM_PROVIDER=ollama            # ollama | fixture (tests only)
REELFORGE_OLLAMA_URL=http://127.0.0.1:11434
REELFORGE_OLLAMA_MODEL=qwen3.5:4b        # qwen3.5:9b for higher quality, qwen3.5:2b for low RAM
REELFORGE_IMAGE_PROVIDER=auto            # auto (ComfyUI, procedural fallback) | comfyui | procedural | fixture
REELFORGE_COMFYUI_URL=http://127.0.0.1:8188
REELFORGE_COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
REELFORGE_COMFYUI_LCM_LORA=lcm-lora-sdv1-5.safetensors
REELFORGE_COMFYUI_STEPS=6
REELFORGE_TTS_PROVIDER=kokoro            # kokoro | fixture
REELFORGE_STT_PROVIDER=faster_whisper    # faster_whisper | fixture
REELFORGE_WHISPER_MODEL=base.en          # small.en is more accurate, slower
REELFORGE_RESEARCH_ENABLED=true          # Wikipedia fact-checking (needs internet)

# --- Worker & limits -----------------------------------------------------------------------------------
REELFORGE_EMBEDDED_WORKER=true           # run the job worker inside the API process (set false and run
                                         # `python -m app.workers.runner` separately in production)
REELFORGE_WORKER_CONCURRENCY=1
REELFORGE_MAX_ACTIVE_JOBS_PER_USER=3
REELFORGE_GENERATION_RATE_LIMIT_PER_HOUR=30
REELFORGE_RATE_LIMIT_PER_MINUTE=120
REELFORGE_MAX_UPLOAD_BYTES=26214400
REELFORGE_FFMPEG_THREADS=4

# --- Frontend (Vite; these ARE public, never put secrets here) -----------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_AUTH_MODE=local
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key>
